#================================
# INTERPOSER DRC MAIN RUNSET
#================================

# Optional definitions
if $run_mode.nil?
  $run_mode = "tiling"
end

if $threads.nil?
  $threads = 4
end

if $verbose.nil?
  $verbose = false
end

# Report settings
report("Interposer DRC Report", File.basename(source.path))

# Load layer definitions
load(File.join(File.dirname(__FILE__), "rule_decks/layers_def.drc"))

# Backend metal stack only - no frontend device rules needed
# Placeholder for specific design rules (spacing, width, etc.)
# These should be defined based on actual process requirements

logger.info("DRC check complete for interposer backend layers")
