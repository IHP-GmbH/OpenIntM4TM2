#=========================================================================================
# Interposer Assembly-Level DRC Rules
# Chiplet placement constraints: overlap, spacing, area, pad association
#=========================================================================================

if BEOL
#===============================================
# --------------- 8.1 Assembly -----------------
#===============================================

  logger.info('Starting 8.1 Assembly chiplet placement checks')

  # Rule ASM.a: No chiplet overlap (exchange0 polygons must not overlap)
  logger.info('Executing rule ASM.a')
  asm_a = exchange0_drw.merged(2)
  asm_a.output('ASM.a', '8.1. ASM.a : Chiplet boundaries must not overlap')
  asm_a.forget

  # Rule ASM.b: Min. chiplet-to-chiplet spacing is 50 um
  logger.info('Executing rule ASM.b')
  asm_b_value = drc_rules['ASM_b'].to_f
  asm_b = exchange0_drw.space(asm_b_value.um, euclidian)
  asm_b.output('ASM.b', "8.1. ASM.b : Min. chiplet-to-chiplet spacing is #{asm_b_value} um")
  asm_b.forget

  # Rule ASM.e: Min. chiplet area is 10000 um2 (sanity check for degenerate polygons)
  logger.info('Executing rule ASM.e')
  asm_e_value = drc_rules['ASM_e'].to_f
  asm_e = exchange0_drw.with_area(nil, asm_e_value.um2)
  asm_e.output('ASM.e', "8.1. ASM.e : Min. chiplet area is #{asm_e_value} um2")
  asm_e.forget

  # Rule ASM.f: Cu Pillar pads must be associated with a chiplet (inside exchange0)
  # Exception: pads on the interposer itself (outside all chiplet boundaries) are allowed
  logger.info('Executing rule ASM.f')
  orphan_pads = cu_pillarpad.not_inside(exchange0_drw)
  # Filter out pads that are on the interposer (not near any chiplet)
  # Only flag pads that partially overlap a chiplet boundary but aren't fully inside
  asm_f = cu_pillarpad.interacting(exchange0_drw).not_inside(exchange0_drw)
  asm_f.output('ASM.f', '8.1. ASM.f : Cu Pillar pads interacting with chiplet must be fully inside')
  orphan_pads.forget
  asm_f.forget

end
