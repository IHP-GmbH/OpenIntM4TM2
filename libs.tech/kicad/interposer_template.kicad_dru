# Generated by libs.tech/kicad/scripts/kicad_rules_gen.py from
# libs.tech/klayout/tech/drc/rule_decks/interposer_tech_default.json
# (version 1.7). Do not edit: change the JSON and run the script.
#
# KiCad loads the rules file named after the board, so copy this file beside
# your board as <board>.kicad_dru. KiCad checks these rules while drawing; the
# KLayout decks on the exported GDS are the DRC that counts.
#
# The deck states no metal-to-edge rule. The project file's copper-to-edge
# floor, 0.001 mm, only keeps copper inside the outline. The seal-ring rules
# are checked by the sealring deck, and a copper keepout from a placed ring is
# the sealring owner's decision: this floor says nothing about it.
#
# Ported, per copper layer: minimum track width and minimum clearance.
#   TopMetal2 (F.Cu): TM2_a, TM2_b
#   TopMetal1 (In1.Cu): TM1_a, TM1_b
#   Metal5 (In2.Cu): Mn_a, Mn_b
#   Metal4 (B.Cu): Mn_a, Mn_b
# Ported, on one item's own size:
#   TopMetal2 (F.Cu): TM2_bR, TM2_bR_w, TM2_bR_cr, as a
#   physical clearance from a track wider than TM2_bR_w (a warning, a
#   check of its own, so a gap under the base space stays an error under
#   that rule) and a clearance from a pad wider than TM2_bR_w and
#   longer than TM2_bR_cr.
#   Every copper layer: Slt_c, as a maximum track width (a warning:
#   a wider track needs slits, and no flow step cuts them. Cutting them is
#   the designer's step, with the KLayout slit macro on the GDS; unslit
#   copper wider than Slt_c fails the deck).
# What KiCad does not catch:
# - It flags a clearance only below the rule less its DRC epsilon, 0.5 um by
#   default. So the Metal5 and Metal4 space is never caught, and the TopMetal
#   spaces only once a gap is 0.5 um under the rule.
# - It enforces the width minimum at the rule value, but its report may name
#   the limit "board setup constraints" rather than the rule.
# - It measures clearance between different nets only, so a same-net notch
#   stays a KLayout check.
# - It has no parallel-run condition, so the track rule also warns, and the
#   pad rule errs, on runs of TM2_bR_cr or less, which the deck accepts.
# - It checks one track or pad at a time: copper merged from several items,
#   and zones, stay KLayout checks for both width-dependent rules.
#
# KLayout only:
#   Pad_aR Pad_a1 Pad_bR Pad_d Pad_dR Pad_eR Pad_fR Pad_gR Padb_a Padb_b
#   Padb_c Padb_d Padb_e Padc_a Padc_b Padc_c Padc_d Padc_e Pas_a Pas_b Pas_c
#   PadU_w PadU_s LBE_a LBE_b LBE_b1 LBE_b2 LBE_c LBE_d LBE_e LBE_i Vn_a Vn_b
#   Vn_b1 Vn_b1_nr Vn_c Vn_c1 TV1_a TV1_b TV1_c TV1_d TV2_a TV2_b TV2_c TV2_d
#   Mn_e Mn_e_w Mn_e_cr Mn_f Mn_f_w Mn_f_cr Mn_g Mn_g_min Mn_i Mn_j Mn_k TM1_c
#   TM1_d TM2_c TM2_d MFil_c MFil_a2 MFil_h MFil_k MFil_h_w TM1Fil_c TM1Fil_a1
#   TM1Fil_b TM2Fil_c TM2Fil_a1 TM2Fil_b Slt_a Slt_b Slt_f Slt_g Slt_h2 Slt_h3
#   Slt_h4 Slt_i Slt_i_w Seal_a Seal_c1 Seal_c2 Seal_c3 Seal_e Seal_f Seal_k
#   Mim_a Mim_b Mim_c Mim_d Mim_e Mim_f Mim_g Mim_gR
(version 1)

(rule "TopMetal2 width (TM2_a)"
	(layer "F.Cu")
	(constraint track_width (min 0.002mm)))

(rule "TopMetal2 clearance (TM2_b)"
	(layer "F.Cu")
	(constraint clearance (min 0.002mm)))

(rule "TopMetal1 width (TM1_a)"
	(layer "In1.Cu")
	(constraint track_width (min 0.00164mm)))

(rule "TopMetal1 clearance (TM1_b)"
	(layer "In1.Cu")
	(constraint clearance (min 0.00164mm)))

(rule "Metal5 width (Mn_a)"
	(layer "In2.Cu")
	(constraint track_width (min 0.0002mm)))

(rule "Metal5 clearance (Mn_b)"
	(layer "In2.Cu")
	(constraint clearance (min 0.00021mm)))

(rule "Metal4 width (Mn_a)"
	(layer "B.Cu")
	(constraint track_width (min 0.0002mm)))

(rule "Metal4 clearance (Mn_b)"
	(layer "B.Cu")
	(constraint clearance (min 0.00021mm)))

(rule "TopMetal2 clearance from a track wider than 0.005mm (TM2_bR)"
	(severity warning)
	(layer "F.Cu")
	(condition "A.Type == 'Track' && A.Width > 0.005mm && A.Net != B.Net")
	(constraint physical_clearance (min 0.005mm)))

(rule "TopMetal2 clearance from a pad wider than 0.005mm and longer than 0.05mm (TM2_bR)"
	(layer "F.Cu")
	(condition "A.Type == 'Pad' && (A.Size_X > 0.05mm || A.Size_Y > 0.05mm) && A.Size_X > 0.005mm && A.Size_Y > 0.005mm")
	(constraint clearance (min 0.005mm)))

(rule "TopMetal2 track wider than 0.03mm needs slits (Slt_c)"
	(severity warning)
	(layer "F.Cu")
	(condition "A.Width > 0.03mm")
	(constraint track_width (max 0.03mm)))

(rule "TopMetal1 track wider than 0.03mm needs slits (Slt_c)"
	(severity warning)
	(layer "In1.Cu")
	(condition "A.Width > 0.03mm")
	(constraint track_width (max 0.03mm)))

(rule "Metal5 track wider than 0.03mm needs slits (Slt_c)"
	(severity warning)
	(layer "In2.Cu")
	(condition "A.Width > 0.03mm")
	(constraint track_width (max 0.03mm)))

(rule "Metal4 track wider than 0.03mm needs slits (Slt_c)"
	(severity warning)
	(layer "B.Cu")
	(condition "A.Width > 0.03mm")
	(constraint track_width (max 0.03mm)))
