#================================
# INTERPOSER LVS MAIN RUNSET
#================================

require 'logger'

# Logger setup (stdout only)
logger = Logger.new($stdout)
logger.formatter = proc do |_severity, datetime, _progname, msg|
  "#{datetime}: #{msg}\n"
end
$stdout.sync = true

# Optional definitions
if $run_mode.nil?
  $run_mode = "flat"
end

if $threads.nil?
  $threads = 4
end

if $verbose.nil?
  $verbose = false
end

# Load input layout (batch mode via -rd input=<path>)
if $input
  if $topcell
    source($input, $topcell)
  else
    source($input)
  end
end

# Report settings
if $report
  report_lvs($report)
else
  input_basename = File.basename(source.path, File.extname(source.path))
  report_lvs("#{input_basename}.lvsdb")
end

# Extracted netlist output (SPICE, net names preserved) when requested
if $target_netlist
  target_netlist($target_netlist, write_spice(true), "Extracted by KLayout LVS - IntM4TM2 interposer")
end

# Run mode
if $run_mode == "deep"
  deep
else
  flat
end

threads($threads)

#================================================
# ------------ LOAD LVS RULE DECKS --------------
#================================================

# Load LVS subscripts via a single eval so local variables (layer defs,
# logger) are shared across all rule decks. Ruby's load() runs in main
# scope and separate eval() calls don't share locals.
rule_deck_path = File.join(File.dirname(__FILE__), "rule_decks")
lvs_files = [
  'layers_definitions.lvs',   # layer inputs
  'mimcap_devices.lvs',       # cap_cmim device class / extractor / reader
  'mimcap_extraction.lvs',    # cap_cmim derivations + device extraction
  'connectivity.lvs'          # metal stack connectivity, checks, compare
]

lvs_source = lvs_files.map { |f|
  path = File.join(rule_deck_path, f)
  File.exist?(path) ? File.read(path) : ""
}.join("\n")
eval(lvs_source)
