<?xml version="1.0" encoding="utf-8"?>
<klayout-macro>
 <description>Fill TopMetal</description>
 <version>0.2</version>
 <category>filler</category>
 <prolog/>
 <epilog/>
 <doc/>
 <autorun>false</autorun>
 <autorun-early>false</autorun-early>
 <priority>0</priority>
 <shortcut/>
 <show-in-menu>true</show-in-menu>
 <group-name>filler</group-name>
 <menu-path>intm4tm2_menu&gt;end("IntM4TM2 Interposer").end</menu-path>
 <interpreter>dsl</interpreter>
 <dsl-interpreter-name>drc-dsl-xml</dsl-interpreter-name>
 <text>
	# Metal-fill generation for the interposer top metals (TopMetal1 and TopMetal2).
	#
	# Companion to interposer_filler_metal.lym. A single 5 x 10 um cell is stamped on
	# a regular grid inside the fill region, spaced by TM(n)Fil.b from the drawn top
	# metal and from any pre-existing filler, to satisfy the TopMetal density band
	# (TM1.c/TM2.c 25% min, TM1.d/TM2.d 70% max).
	#
	# Corrected against the earlier version of this macro:
	#   - pre-existing filler is sized by TM(n)Fil.b before being subtracted, so a
	#     rerun or an imported block already carrying fill cannot land new fill closer
	#     than the 3.0 um filler-to-filler minimum. The earlier macro subtracted the
	#     raw, unsized filler and relied on a 3.05 um fudge to hide the resulting
	#     violations; TM(n)Fil.b is now a real checked rule (5_23 / 5_26), so the
	#     keep-out is done properly and the lattice gap is exactly the rule value.
	#   - no TRANS (26/0) or other front-end layers: those markers are absent from the
	#     interposer layer map, so their keep-outs were permanently empty. Only the
	#     layers that exist on an interposer are referenced.
	#   - the fill region falls back prBoundary &gt; EdgeSeal interior (holes) &gt; layout
	#     extent instead of only EdgeSeal.holes, so a layout without a closed seal ring
	#     is still filled rather than silently skipped.

	# --- fill geometry parameters ---
	width   = 5.0   # TopMetal filler cell width;  &lt;= TM(n)Fil.a1 (max filler width 10.0 um)
	height  = 10.0  # TopMetal filler cell height; &lt;= TM(n)Fil.a1
	tmfil_c = 3.0   # TM(n)Fil.c: min filler-to-TopMetal(n) space (interposer_tech_default.json)
	tmfil_b = 3.0   # TM(n)Fil.b: min filler-to-filler space; also the lattice gap

	# --- fill region: prBoundary (235/0) &gt; EdgeSeal interior (39/0 holes) &gt; extent ---
	prb  = source.input("235/0")
	seal = source.input("39/0")
	if prb.count &gt; 0
	  base = prb
	elsif seal.count &gt; 0
	  base = seal.holes
	else
	  base = extent
	end

	# --- per-metal fill: TopMetal1 (126, vias 125/133), TopMetal2 (134, via 133) ---
	[[126, "TM1", ["125/0", "133/0"]], [134, "TM2", ["133/0"]]].each do |ml, nm, vias|
	  metal  = source.input("#{ml}/0")
	  filler = source.input("#{ml}/22")
	  nofill = source.input("#{ml}/23")
	  slit   = source.input("#{ml}/24")
	  nomet  = source.input("160/0")

	  # keep-out: TM(n)Fil.c from drawn top metal and from the vias landing on it;
	  # TM(n)Fil.b from pre-existing filler so a rerun cannot merge new fill into old;
	  # honor designer nofill and the global NoMetFiller marker.
	  excl = metal.sized(tmfil_c) | filler.sized(tmfil_b) | nofill | slit | nomet
	  vias.each { |v| excl = excl | source.input(v).sized(tmfil_c) }
	  region = base - excl

	  pat = fill_pattern("#{nm}_FILL_CELL").shape(ml, 22, box(0.0, 0.0, width, height))
	  region.fill(pat, hstep(width + tmfil_b), vstep(height + tmfil_b))
	end
 </text>
</klayout-macro>
