#================================
# INTERPOSER DRC MAIN RUNSET
#================================

require 'json'
require 'logger'

# Logger setup (stdout only)
logger = Logger.new($stdout)
logger.formatter = proc do |_severity, datetime, _progname, msg|
  "#{datetime}: #{msg}\n"
end
$stdout.sync = true

# Optional definitions
if $run_mode.nil?
  $run_mode = "tiling"
end

if $threads.nil?
  $threads = 4
end

if $verbose.nil?
  $verbose = false
end

# DRC tolerance for floating point comparisons
drc_tole = 1e-6

# Control flags
BEOL = true
PRECHECK_DRC = false

# Load input layout (batch mode via -rd input=<path>)
if $input
  if $topcell
    source($input, $topcell)
  else
    source($input)
  end
end

# Report settings
if $report
  report("Interposer DRC Report", $report)
else
  input_basename = File.basename(source.path, File.extname(source.path))
  report("Interposer DRC Report", "#{input_basename}_drc.lyrdb")
end

#================================================
# ------------ LOAD DRC RULE VALUES -------------
#================================================

rule_deck_path = File.join(File.dirname(__FILE__), "rule_decks")
json_file = File.join(rule_deck_path, "interposer_tech_default.json")

if File.exist?(json_file)
  json_data = JSON.parse(File.read(json_file))
  drc_rules = json_data['rules']
  logger.info("Loaded DRC rules from #{json_file}")
else
  logger.warn("DRC rules file not found: #{json_file}")
  drc_rules = {}
end

#================================================
#------------ PRE-DEFINED FUNCTIONS -------------
#================================================

# Function to detect circular shapes (required for Cu Pillar shape validation)
def get_circle(polygon_check)
  maybe_circle1 = polygon_check.with_bbox_aspect_ratio(1)
  maybe_circle2 = maybe_circle1.select { |polygon| polygon.num_points >= 16 }
  # Circle detection based on area ratio of bounding box to shape area ~ 4/pi ~ 1.2732
  # (Derived from: (d^2) / (pi * d^2 / 4) = 4/pi)
  maybe_circle2.without_holes.with_area_ratio(1.270, 1.276)
end

# Function to detect octagonal shapes (required for solder-bump opening validation)
def get_octagon(polygon_check)
  maybe_oct1 = polygon_check.with_bbox_aspect_ratio(1)
  maybe_oct2 = maybe_oct1.select { |polygon| polygon.num_points == 8 }
  h_edges_check = maybe_oct2.edges.with_angle(0, absolute)
  maybe_oct3 = maybe_oct2.interacting(h_edges_check, 2, 2)
  v_edges_check = maybe_oct3.edges.with_angle(90, absolute)
  maybe_oct4 = maybe_oct3.interacting(v_edges_check, 2, 2)
  diag_edges_check = maybe_oct4.edges.with_angle(44.5, 45.5, absolute)
  maybe_oct4.interacting(diag_edges_check, 4, 4)
end

# Function to check for missing interposer key values
def fetch_rule(rules, key)
  unless rules.is_a?(Hash) && rules.key?(key) && !rules[key].nil?
    raise "DRC rule '#{key}' missing in interposer_tech_default.json"
  end
  Float(rules[key])
end


#================================================
# ------------ LOAD LAYER DEFINITIONS -----------
#================================================

# Load DRC subscripts via a single eval so local variables (layer defs,
# drc_rules, logger) are shared across all rule decks. Ruby's load() runs in
# main scope and separate eval() calls don't share locals.
#
# Deck selection: pass -rd deck=<name>[,<name>...] to run specific decks only.
# Without $deck, all decks bar DEFAULT_SKIP_DECKS are loaded (backward
# compatible). The deck registry and the file-selection logic live in
# intm4tm2_decks.rb, shared verbatim with the Python tooling and the registry
# CI check so the two halves cannot drift.
require File.join(File.dirname(__FILE__), 'intm4tm2_decks')

requested = ($deck && !$deck.empty?) ? $deck.split(',').map(&:strip) : nil
drc_files, unknown_decks = IntM4TM2Decks.deck_files(requested)
unknown_decks.each { |name|
  logger.warn("Unknown deck '#{name}'. Available: #{IntM4TM2Decks::ALL_DECKS.keys.join(', ')}")
}

# drc_files is the sanctioned deck selection: compose it ONLY through
# deck_files() above, never by filtering or appending to it here. The
# deck-registry check validates what deck_files() emits and compares the
# registry against rule_decks/ on disk; it never inspects this runtime array,
# so a post-call filter or append is invisible to it (the symmetric counterpart
# of the documented Python read-then-filter residual). The one adjacent guard is
# unrelated: a *.drc dropped into rule_decks/ that no deck registers is flagged
# as an orphan, whether or not anything appends it here.
drc_source = drc_files.map { |f|
  path = File.join(rule_deck_path, f)
  unless File.exist?(path)
    raise "DRC rule deck not found: #{path} " \
          "(registered in intm4tm2_decks.rb but missing from rule_decks/)"
  end
  File.read(path)
}.join("\n")
eval(drc_source)

logger.info("DRC check complete for interposer backend layers")
