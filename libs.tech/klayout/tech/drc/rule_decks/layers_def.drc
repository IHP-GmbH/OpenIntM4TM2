#==================================
# ------ INTERPOSER LAYERS --------
#==================================

# Boundary layer
prboundary = polygons(189, 0)

# MIM capacitor layers
mim = polygons(36, 0)
vmim = polygons(129, 0)

# Metal4 layers
metal4 = polygons(50, 0)
metal4_pin = polygons(50, 2)
metal4_mask = polygons(50, 20)
metal4_filler = polygons(50, 22)
metal4_nofill = polygons(50, 23)
metal4_slit = polygons(50, 24)
metal4_text = polygons(50, 25)
metal4_opc = polygons(50, 26)
metal4_noqrc = polygons(50, 28)
metal4_res = polygons(50, 29)
metal4_iprobe = polygons(50, 33)
metal4_diffprb = polygons(50, 34)

# Via4 layer
via4 = polygons(66, 0)

# Metal5 layers
metal5 = polygons(67, 0)
metal5_pin = polygons(67, 2)
metal5_mask = polygons(67, 20)
metal5_filler = polygons(67, 22)
metal5_nofill = polygons(67, 23)
metal5_slit = polygons(67, 24)
metal5_text = polygons(67, 25)
metal5_opc = polygons(67, 26)
metal5_noqrc = polygons(67, 28)
metal5_res = polygons(67, 29)
metal5_iprobe = polygons(67, 33)
metal5_diffprb = polygons(67, 34)

# TopVia1 layer
topvia1 = polygons(125, 0)

# TopMetal1 layers
topmetal1 = polygons(126, 0)
topmetal1_pin = polygons(126, 2)
topmetal1_mask = polygons(126, 20)
topmetal1_filler = polygons(126, 22)
topmetal1_nofill = polygons(126, 23)
topmetal1_slit = polygons(126, 24)
topmetal1_text = polygons(126, 25)
topmetal1_noqrc = polygons(126, 28)
topmetal1_res = polygons(126, 29)
topmetal1_iprobe = polygons(126, 33)
topmetal1_diffprb = polygons(126, 34)

# TopVia2 layer
topvia2 = polygons(133, 0)

# TopMetal2 layers
topmetal2 = polygons(134, 0)
topmetal2_pin = polygons(134, 2)
topmetal2_mask = polygons(134, 20)
topmetal2_filler = polygons(134, 22)
topmetal2_nofill = polygons(134, 23)
topmetal2_slit = polygons(134, 24)
topmetal2_text = polygons(134, 25)
topmetal2_noqrc = polygons(134, 28)
topmetal2_res = polygons(134, 29)
topmetal2_iprobe = polygons(134, 33)
topmetal2_diffprb = polygons(134, 34)

# MEMS and special layers
memvia = polygons(145, 0)
thinfilmres = polygons(146, 0)
rfmem = polygons(147, 0)

# Passivation layers
passiv = polygons(9, 0)
passiv_pin = polygons(9, 2)
passiv_pillar = polygons(9, 35)
passiv_sbump = polygons(9, 36)
passiv_pdl = polygons(9, 40)

# EdgeSeal layers
edgeseal = polygons(39, 0)
edgeseal_boundary = polygons(39, 4)

# Pad recognition layers
dfpad = polygons(41, 0)
dfpad_pillar = polygons(41, 35)
dfpad_sbump = polygons(41, 36)

# Text layer
text = labels(63, 0)

# Pad derivations
# Per SG13G2 Layout Rules Rev 2.1:
#   Pad         = (Passiv + Passiv:sbump + Passiv:pillar) + dfpad
#   CuPillarPad = Passiv:pillar + dfpad
#   SBumpPad    = Passiv:sbump  + dfpad
# TopMetal2 presence is enforced separately by Pad.i (dfpad without TM2 not allowed).
pad = passiv.and(dfpad).and(topmetal2)
cu_pillarpad = passiv_pillar.and(dfpad_pillar)
sbumppad = passiv_sbump.and(dfpad_sbump)

# LBE layer (Localized Backside Etch)
lbe = polygons(157, 0)

# IND layers (Inductor marker - visual only)
ind = polygons(27, 0)
ind_pin = polygons(27, 2)
ind_text = labels(27, 25)

# Recognition layers for Cu Pillar and Solder Bump
recog = polygons(99, 0)
recog_pillar = polygons(99, 35)
recog_sbump = polygons(99, 36)

# Note: the post-passivation 3D interconnect bodies (cu-pillar body 500/35,
# SnAg cap 501/35, solder ball 502/36) are owned by the interconnect PDK
# (interconnect_pdk/libs.tech/klayout/tech/drc/rule_decks/layers_def_3d.drc),
# not this interposer deck. The interposer fabricates only the UBM openings
# (9/35, 41/35, 99/35).

#==================================
# ------ ALIAS FOR DRC RULES ------
#==================================
# Aliases with _drw suffix for compatibility with rule decks

metal4_drw = metal4
metal5_drw = metal5
topmetal1_drw = topmetal1
topmetal2_drw = topmetal2
via4_drw = via4
topvia1_drw = topvia1
topvia2_drw = topvia2
dfpad_drw = dfpad
passiv_drw = passiv
edgeseal_drw = edgeseal
lbe_drw = lbe
prboundary_drw = prboundary

# CHIP extent (bounding box of the design)
CHIP = extent.sized(0.0)
