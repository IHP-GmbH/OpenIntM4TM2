# This deck implements min. width / space (M{n}.a, M{n}.b) plus the wide-line
# (M{n}.e, M{n}.f) and 45-degree geometry (M{n}.g, M{n}.i) checks for Metal4 and
# Metal5. The wide-line / 45-degree checks are skipped in the pre-check pass.

if BEOL
  #===============================================
  #--------------- 17. metal -----------------
  #===============================================

  logger.info('Starting 5.17. metal table')

  metals_lay = [metal4_drw, metal5_drw]
  metal_start_index = 4

  metals_lay.each_with_index do |met_lay, index|
    met_no = metal_start_index + index

    logger.info("Executing rule M#{met_no}.a")

    met_nseal = met_lay.not(edgeseal_drw)

    mn_a_value = fetch_rule(drc_rules, 'Mn_a')
    mn_a_l = met_nseal.width(mn_a_value.um, euclidian)
    mn_a_l.output("M#{met_no}.a", "5.17. M#{met_no}.a: Min. Metal#{met_no} width: #{mn_a_value} um.")
    mn_a_l.forget

    logger.info("Executing rule M#{met_no}.b")
    mn_b_value = fetch_rule(drc_rules, 'Mn_b')
    mn_b_l = met_nseal.space(mn_b_value.um, euclidian)
    mn_b_l.output("M#{met_no}.b", "5.17. M#{met_no}.b: Min. Metal#{met_no} space or notch: #{mn_b_value} um.")
    mn_b_l.forget

    # The wide-line (M{n}.e/f) and 45-degree (M{n}.g/i) checks are geometry/parallel-run
    # rules skipped in the fast pre-check pass. sg13g2 guards them with "next if PRECHECK_DRC";
    # here they are wrapped in "unless PRECHECK_DRC" so the met_nseal intermediate layer owned
    # by this loop iteration is still forgotten in the pre-check pass.
    unless PRECHECK_DRC
      # INTERPOSER DEVIATION: sg13g2 applies M{n}.e/f/g/i on the raw metal layer. Here they
      # run on the seal-excluded metal (met_nseal = met.not(edgeseal_drw)), matching the
      # existing M{n}.a/M{n}.b so edge-seal geometry is never flagged by the interposer deck.

      # Rule M{n}.e: Min. space of Metal{n} lines if at least one line is wider than Mn_e_w
      # and the parallel run is longer than Mn_e_cr.
      # Wide seed = layer under/over-sized by Mn_e_w/2 (thin lines vanish); then a two-layer
      # separation between the layer and the wide seed limited to parallel runs over Mn_e_cr.
      logger.info("Executing rule M#{met_no}.e")
      mn_e_value = fetch_rule(drc_rules, 'Mn_e')
      mn_e_w = fetch_rule(drc_rules, 'Mn_e_w') / 2
      mn_e_cr = fetch_rule(drc_rules, 'Mn_e_cr')
      mn_e_seed = met_nseal.sized(-1 * mn_e_w.um).sized(mn_e_w.um)
      mn_e_l = met_nseal.sep(mn_e_seed, mn_e_value.um, projection_limits(mn_e_cr.um + 0.001.um, nil))
      mn_e_l.output("M#{met_no}.e",
                    "5.17. M#{met_no}.e: Min. Metal#{met_no} space if a line wider than #{mn_e_w * 2} um with parallel run over #{mn_e_cr} um: #{mn_e_value} um.")
      mn_e_seed.forget
      mn_e_l.forget

      # Rule M{n}.f: same construct with the wider (Mn_f_w) / longer (Mn_f_cr) thresholds.
      logger.info("Executing rule M#{met_no}.f")
      mn_f_value = fetch_rule(drc_rules, 'Mn_f')
      mn_f_w = fetch_rule(drc_rules, 'Mn_f_w') / 2
      mn_f_cr = fetch_rule(drc_rules, 'Mn_f_cr')
      mn_f_seed = met_nseal.sized(-1 * mn_f_w.um).sized(mn_f_w.um)
      mn_f_l = met_nseal.sep(mn_f_seed, mn_f_value.um, projection_limits(mn_f_cr.um + 0.001.um, nil))
      mn_f_l.output("M#{met_no}.f",
                    "5.17. M#{met_no}.f: Min. Metal#{met_no} space if a line wider than #{mn_f_w * 2} um with parallel run over #{mn_f_cr} um: #{mn_f_value} um.")
      mn_f_seed.forget
      mn_f_l.forget

      # Rule M{n}.g: Min. width of 45-degree bent Metal{n} when the bent segment is longer
      # than Mn_g_min. Select 45-degree edges longer than Mn_g_min, then width-check them.
      logger.info("Executing rule M#{met_no}.g")
      mn_g_value = fetch_rule(drc_rules, 'Mn_g')
      mn_g_min = fetch_rule(drc_rules, 'Mn_g_min')
      mn_g_e45 = met_nseal.edges.with_angle(45, absolute)
      mn_g_bent = mn_g_e45.with_length(mn_g_min.um + 0.001.um, nil)
      mn_g_l = mn_g_bent.width(mn_g_value.um, euclidian)
      mn_g_l.output("M#{met_no}.g",
                    "5.17. M#{met_no}.g: Min. 45-degree bent Metal#{met_no} width if bent length over #{mn_g_min} um: #{mn_g_value} um.")
      mn_g_e45.forget
      mn_g_bent.forget
      mn_g_l.forget

      # Rule M{n}.i: Min. space of Metal{n} lines of which at least one is bent by 45 degrees.
      # Separation between all metal edges and the 45-degree metal edges.
      logger.info("Executing rule M#{met_no}.i")
      mn_i_value = fetch_rule(drc_rules, 'Mn_i')
      mn_i_e45 = met_nseal.edges.with_angle(45, absolute)
      mn_i_l = met_nseal.edges.sep(mn_i_e45, mn_i_value.um, euclidian)
      mn_i_l.output("M#{met_no}.i",
                    "5.17. M#{met_no}.i: Min. Metal#{met_no} space with at least one 45-degree bent line: #{mn_i_value} um.")
      mn_i_e45.forget
      mn_i_l.forget
    end

    met_nseal.forget
  end
end
