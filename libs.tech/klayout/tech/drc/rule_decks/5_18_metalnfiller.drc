if BEOL
  #================================================
  #----------------- 5.18 Metaln:filler -----------
  #================================================

  logger.info('Starting 5.18 Metaln:filler table')

  # Metaln:filler derivations
  #
  # DEVIATION: the sg13g2 source iterates over Metal1..Metal5 fillers. The
  # interposer metal stack exposes only Metal4 and Metal5 (see layers_def.drc),
  # so this port covers exactly those two metals. The rule construction is
  # otherwise identical to the reference. The en_tiles/setup_run_mode blocks of
  # the source are stripped (the interposer engine runs flat).
  metalnfil_sets = [
    [metal4_filler, metal4_drw, 4],
    [metal5_filler, metal5_drw, 5],
  ]

  metalnfil_sets.each do |metalnfil_filler, metalnfil_metal, metalnfil_no|
    # Rule MFil.c: Min. Metal(n):filler space to Metal(n) is 0.42 um
    logger.info("Executing rule M#{metalnfil_no}Fil.c")
    metalnfil_c_val = fetch_rule(drc_rules, 'MFil_c')
    metalnfil_c_l = metalnfil_metal.sep(metalnfil_filler, metalnfil_c_val.um, euclidian)
    metalnfil_c_l.output("M#{metalnfil_no}Fil.c",
                         "5.18. M#{metalnfil_no}Fil.c : Min. Metal#{metalnfil_no}:filler space to Metal#{metalnfil_no} is #{metalnfil_c_val} um")
    metalnfil_c_l.forget

    # Rule MFil.iso: Metal(n):filler must not touch or overlap Metal(n).
    #
    # DEVIATION: not in the sg13g2 source, which checks filler-to-metal only with
    # the MFil.c separation above. A separation rule constrains shapes that are
    # apart, so it is silent on a filler polygon that overlaps drawn metal. Two
    # shapes it cannot see: a filler wholly inside a drawn polygon, and a filler
    # overlapping two drawn polygons at once.
    #
    # Retained pre-fix measurements used separate Metal4 layouts. The bridge
    # passed the twenty default decks. The containment layout was checked only
    # against metalnfiller: its deliberate near-spacing control was reported,
    # while the contained filler was not. These are not measurements of every
    # contact shape or of the corresponding TopMetal layers.
    #
    # Not measured, and recorded here as reasoning rather than as established
    # fact. That the datatypes of a metal layer are merged into one fabricated
    # shape, which is what would make the bridging case an electrical rather than
    # a geometric defect. And that LVS would not catch it, which is a reading of
    # the connect statements in layers_definitions.lvs with no extraction run
    # behind it. Confirm both with IHP before either is repeated as fact.
    #
    # This rule is not aimed at fill produced by the generators in this repo, and
    # says nothing about whether any generator is safe. It is aimed at fill that
    # arrives already placed, hand-drawn, from another generator, or inside an
    # imported block, where nothing in this flow constrains how it was made.
    # `interacting` is the right predicate rather than an overlap area test:
    # MFil.c already requires 0.42 um of space, so any contact at all is a
    # violation and a corner touch is as wrong as an overlap.
    logger.info("Executing rule M#{metalnfil_no}Fil.iso")
    metalnfil_iso_l = metalnfil_filler.interacting(metalnfil_metal)
    metalnfil_iso_l.output("M#{metalnfil_no}Fil.iso",
                           "5.18. M#{metalnfil_no}Fil.iso : Metal#{metalnfil_no}:filler must not touch or overlap Metal#{metalnfil_no} (isolation)")
    metalnfil_iso_l.forget

    next if PRECHECK_DRC

    # Rule MFil.a2: Max. Metal(n):filler width is 5.00 um
    logger.info("Executing rule M#{metalnfil_no}Fil.a2")
    metalnfil_a2_val = fetch_rule(drc_rules, 'MFil_a2')
    metalnfil_a2_l = metalnfil_filler.with_bbox_max(metalnfil_a2_val.um + 0.001.um, nil)
    metalnfil_a2_l.output("M#{metalnfil_no}Fil.a2",
                          "5.18. M#{metalnfil_no}Fil.a2 : Max. Metal#{metalnfil_no}:filler width is #{metalnfil_a2_val} um")
    metalnfil_a2_l.forget
  end
end
