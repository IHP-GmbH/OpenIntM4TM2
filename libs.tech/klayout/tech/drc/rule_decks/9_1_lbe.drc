if BEOL
  #================================================
  #------------------- 9.1. LBE -------------------
  #================================================

  logger.info('Starting 9.1. LBE table')

  # LBE derivations
  lbe_in_seal = lbe_drw.inside(edgeseal_drw.holes)

  # Rule LBE.a: Min. LBE width is 100.00µm
  logger.info('Executing rule LBE.a')
  lbe_a_value = fetch_rule(drc_rules, 'LBE_a')
  lbea_l1 = lbe_drw.width(lbe_a_value.um, euclidian)
  lbea_l1.output('LBE.a', "9.1. LBE.a: Min. LBE width: #{lbe_a_value} µm")
  lbea_l1.forget

  # Rule LBE.b: Max. LBE width is 1500µm.
  logger.info('Executing rule LBE.b')
  lbe_b_value = fetch_rule(drc_rules, 'LBE_b')
  lbeb_l1 = lbe_drw.with_bbox_max(lbe_b_value.um + 0.001.um, nil)
  lbeb_l1.output('LBE.b', "9.1. LBE.b: Max. LBE width: #{lbe_b_value} µm.")
  lbeb_l1.forget

  # Rule LBE.b1:  Max. LBE area (µm²) is 250000.
  logger.info('Executing rule LBE.b1')
  lbe_b1_value = fetch_rule(drc_rules, 'LBE_b1')
  lbeb1_l1 = lbe_drw.with_area(lbe_b1_value.um + 0.001.um, nil)
  lbeb1_l1.output('LBE.b1', "9.1. LBE.b1: Max. LBE area (µm²): #{lbe_b1_value} .um")
  lbeb1_l1.forget

  # Rule LBE.c: Min. LBE space or notch is 100.00µm
  logger.info('Executing rule LBE.c')
  lbe_c_value = fetch_rule(drc_rules, 'LBE_c')
  lbec_l1 = lbe_drw.space(lbe_c_value.um, euclidian)
  lbec_l1.output('LBE.c', "9.1. LBE.c: Min. LBE space or notch: #{lbe_c_value} µm")
  lbec_l1.forget

  # Rule LBE.d: Min. LBE space to inner edge of EdgeSeal is 150.00µm
  logger.info('Executing rule LBE.d')
  lbe_d_value = fetch_rule(drc_rules, 'LBE_d')
  lbed_l1 = lbe_in_seal.sep(edgeseal_drw, lbe_d_value.um, euclidian)
  lbed_l1.output('LBE.d', "9.1. LBE.d: Min. LBE space to inner edge of EdgeSeal: #{lbe_d_value} µm")
  lbed_l1.forget

  # Rule LBE.h: No LBE ring allowed.
  logger.info('Executing rule LBE.h')
  lbeh_l1 = lbe_drw.interacting(lbe_drw.holes)
  lbeh_l1.output('LBE.h', '9.1. LBE.h: No LBE ring allowed.')
  lbeh_l1.forget

  # Rule LBE.b2: Min. LBE area (µm²) is 30000.00
  # DEVIATION: the sg13g2_maximal.drc source literal is 250000 (ext_with_area([["<", 250000.0.um2]])),
  # but that value duplicates LBE.b1's max-area bound (250000) and its OWN output message states 30000.
  # We implement the message value (LBE_b2 = 30000) as a minimum-area check pending spec confirmation.
  logger.info('Executing rule LBE.b2')
  lbe_b2_value = fetch_rule(drc_rules, 'LBE_b2')
  lbeb2_l1 = lbe_drw.with_area(nil, lbe_b2_value.um2)
  lbeb2_l1.output('LBE.b2', "9.1. LBE.b2: Min. LBE area (µm²): #{lbe_b2_value}")
  lbeb2_l1.forget

  # Rule LBE.e.dfPad: Min. LBE space to dfpad is 50.00µm
  # DEVIATION: the source uses ext_separation(dfpad, 50, consider_intersecting_edges: false,
  # ignore_non_axis_aligned_edges: true). Those two options have no single-call DSL equivalent, so we
  # use a plain euclidian sep. That is slightly STRICTER than the source (it also counts intersecting
  # and non-axis-aligned edge pairs the source would suppress); acceptable for a min-space check.
  logger.info('Executing rule LBE.e.dfPad')
  lbe_e_value = fetch_rule(drc_rules, 'LBE_e')
  lbe_e_df_l = lbe_drw.sep(dfpad_drw, lbe_e_value.um, euclidian)
  lbe_e_df_l.output('LBE.e.dfPad', "9.1. LBE.e.dfPad: Min. LBE space to dfpad: #{lbe_e_value} µm")
  lbe_e_df_l.forget

  # Rule LBE.e.Passiv: Min. LBE space to Passiv is 50.00µm
  # DEVIATION: same as LBE.e.dfPad -- plain euclidian sep is slightly stricter than the source's
  # consider_intersecting_edges:false / ignore_non_axis_aligned_edges:true options.
  logger.info('Executing rule LBE.e.Passiv')
  lbe_e_pas_l = lbe_drw.sep(passiv_drw, lbe_e_value.um, euclidian)
  lbe_e_pas_l.output('LBE.e.Passiv', "9.1. LBE.e.Passiv: Min. LBE space to Passiv: #{lbe_e_value} µm")
  lbe_e_pas_l.forget

  # Rule LBE.f: Min. LBE space to Activ is 30.00µm
  logger.info('Executing rule LBE.f')
  lbe_f_value = fetch_rule(drc_rules, 'LBE_f')
  lbe_f_l = lbe_drw.sep(activ_drw, lbe_f_value.um, euclidian)
  lbe_f_l.output('LBE.f', "9.1. LBE.f: Min. LBE space to Activ: #{lbe_f_value} µm")
  lbe_f_l.forget

end
