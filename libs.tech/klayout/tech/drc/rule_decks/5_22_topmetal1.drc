# This deck implements only minimum width and minimum spacing/notch checks for TopMetal1.
# Wide-line and 45-degree spacing rules yet to implement.
# Recommended and PRECHECK-tier rules are intentionally not implemented here.

if BEOL
  #===============================================
  #--------------- 22. TopMetal1 -----------------
  #===============================================

  logger.info('Starting 5.22. TopMetal1 table')

  # TopMetal1 derivations
  tm1_nseal = topmetal1_drw.not(edgeseal_drw)

  # Rule tm1.a: Min. TopMetal1 width, value from JSON.

  logger.info('Executing rule TM1.a')
  tm1_a_value = fetch_rule(drc_rules, 'TM1_a')
  tm1_a_l = tm1_nseal.width(tm1_a_value.um, euclidian)
  tm1_a_l.output('TM1.a', "5.22. TM1.a: Min. TopMetal1 width: #{tm1_a_value} um.")
  tm1_a_l.forget

  # Rule tm1.b: Min. TopMetal1 space, value from JSON.
  logger.info('Executing rule TM1.b')
  tm1_b_value = fetch_rule(drc_rules, 'TM1_b')
  tm1_b_l = tm1_nseal.space(tm1_b_value.um, euclidian)
  tm1_b_l.output('TM1.b', "5.22. TM1.b: Min. TopMetal1 space or notch: #{tm1_b_value} um.")
  tm1_b_l.forget

  tm1_nseal.forget
end
