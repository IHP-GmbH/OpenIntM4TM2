if BEOL
  #================================================
  #----------------- 5.26 TopMetal2:filler --------
  #================================================

  logger.info('Starting 5.26 TopMetal2:filler table')

  # TopMetal2:filler derivations
  # The en_tiles/setup_run_mode blocks of the source are stripped (the interposer
  # engine runs flat).

  # Rule TM2Fil.c : Min. TopMetal2:filler space to TopMetal2 is 3 um
  logger.info('Executing rule TM2Fil.c')
  tm2fil_c_val = fetch_rule(drc_rules, 'TM2Fil_c')
  tm2fil_c_l = topmetal2_drw.sep(topmetal2_filler, tm2fil_c_val.um, euclidian)
  tm2fil_c_l.output('TM2Fil.c', "5.26. TM2Fil.c : Min. TopMetal2:filler space to TopMetal2 is #{tm2fil_c_val} um")
  tm2fil_c_l.forget

  unless PRECHECK_DRC
    # Rule TM2Fil.a1 : Max. TopMetal2:filler width is 10.00 um
    logger.info('Executing rule TM2Fil.a1')
    tm2fil_a1_val = fetch_rule(drc_rules, 'TM2Fil_a1')
    tm2fil_a1_l = topmetal2_filler.with_bbox_max(tm2fil_a1_val.um + 0.001.um, nil)
    tm2fil_a1_l.output('TM2Fil.a1', "5.26. TM2Fil.a1 : Max. TopMetal2:filler width is #{tm2fil_a1_val} um")
    tm2fil_a1_l.forget
  end
end
