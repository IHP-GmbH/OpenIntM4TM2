# Interposer passivation-opening lithographic floor
# Based on IHP SG13G2 Layout Rules Rev 2.1, Sections 5.27 / 6.9
#
# Pas.a/Pas.b (5_27_passiv.drc, rule table 5.27) run on passiv_drw =
# polygons(9,0) ONLY. The Cu-pillar and solder-bump passivation openings live on
# their own datatypes, Passiv:pillar = polygons(9,35) (passiv_pillar) and
# Passiv:sbump = polygons(9,36) (passiv_sbump), which the 5.27 rule never reaches.
# Padc.b/Padb.b on those datatypes are per-method attachment spacings, not the
# lithographic opening limit.
#
# This deck applies the SAME method-independent passivation-opening litho floor
# that 5.27 enforces on 9/0, Pas.a (2.10 um min width) and Pas.b (3.50 um min
# space), to the pad-opening datatypes 9/35 and 9/36, including the 9/35-to-9/36
# cross-datatype separation that nothing else checks. It is the always-on
# manufacturability base underneath the per-method Padc.*/Padb.* attachment
# checks. The rule ids (PadU.w, PadU.s) are STABLE so the value can be swapped
# later without renaming, so waivers and testcases survive.
#=========================================================================================

if BEOL
  logger.info('Starting 6.9 UBM / passivation-opening floor table')

  ubm_open = passiv_pillar.join(passiv_sbump)
  ubm_tol = 0.01  # circle-discretization tolerance (see Padc.b rationale)

  logger.info('Executing rule PadU.w')
  padu_w_value = fetch_rule(drc_rules, 'PadU_w')
  padu_w = ubm_open.width(padu_w_value.um - ubm_tol, euclidian)
  padu_w.output('PadU.w', "6.9. PadU.w [5.27 litho floor, from Pas.a] : Min. UBM/passivation opening width is #{padu_w_value} um")
  padu_w.forget

  logger.info('Executing rule PadU.s')
  padu_s_value = fetch_rule(drc_rules, 'PadU_s')
  padu_s = ubm_open.space(padu_s_value.um - ubm_tol, euclidian)
  padu_s.output('PadU.s', "6.9. PadU.s [5.27 litho floor, from Pas.b] : Min. UBM/passivation opening space is #{padu_s_value} um")
  padu_s.forget

  ubm_open.forget
end
