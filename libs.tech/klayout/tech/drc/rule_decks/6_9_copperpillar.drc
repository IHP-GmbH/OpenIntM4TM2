# Interposer Cu Pillar DRC Rules
# Based on IHP SG13G2 Layout Rules Rev 2.1, Section 6.9.2
#
# Device recognition: CuPillarPad = Passiv:pillar + dfpad  (per document)
#
# Rule values are from Table 6.1. The JSON (interposer_tech_default.json) is
# configured for Option 1 (35 um opening). To use Option 2 (40 um) or
# Option 3 (45 um), update Padc_a/b/e in the JSON accordingly:
#   Option 1: Padc_a=35, Padc_b=40, Padc_e=75
#   Option 2: Padc_a=40, Padc_b=40, Padc_e=80
#   Option 3: Padc_a=45, Padc_b=50, Padc_e=95
# Padc_c (7.5) and Padc_d (30) are the same for all options.
#
# Note from document: Padc.e (pitch) and Padc.f (shape) are marked as
# "not checked during DRC" in the layout rules. We check them anyway as
# additional safeguards for the interposer flow.
#=========================================================================================

if BEOL
#===============================================
# ------------------ 6.9.2 Copper Pillar -------
#===============================================

  logger.info('Starting 6.9.2 Copper Pillar table')

  # Rule Padc.a: CuPillarPad size is 35 um (default, see Table 6.1 for other options: 40, 45 um)
  logger.info('Executing rule Padc.a')
  padc_a_value = drc_rules['Padc_a'].to_f
  padc_a_l1 = cu_pillarpad.width(padc_a_value.um - drc_tole, projection, projection_limits(nil, 10 * drc_tole)).polygons
  padc_a_l2 = cu_pillarpad.with_bbox_width(nil, padc_a_value.um)
  padc_a = padc_a_l1.join(padc_a_l2)
  padc_a.output('Padc.a', "6.9.2. Padc.a : CuPillarPad size is #{padc_a_value} um")
  padc_a_l1.forget
  padc_a_l2.forget
  padc_a.forget

  # Rule Padc.b : Min. CuPillarPad space is 40 um (default, see Table 6.1 for other options)
  # Tolerance accounts for polygon discretization of circular pads (same
  # rationale as Padc.c below): a layout drawn exactly at the minimum
  # measures a few nm short of it after 256-point approximation + nm grid.
  logger.info('Executing rule Padc.b')
  padc_b_value = drc_rules['Padc_b'].to_f
  padc_b_tol = 0.01  # 10nm tolerance for circle-approximated spacing
  padc_b = cu_pillarpad.space(padc_b_value.um - padc_b_tol, euclidian)
  padc_b.output('Padc.b', "6.9.2. Padc.b : Min. CuPillarPad space is #{padc_b_value} um")
  padc_b.forget

  # Rule Padc.c: Min. TopMetal2 (within dfpad) enclosure of CuPillarPad is 7.5 um
  logger.info('Executing rule Padc.c')
  padc_c_value = drc_rules['Padc_c'].to_f
  # Tolerance accounts for polygon discretization of circular shapes (~1nm at 256 points)
  padc_c_tol = 0.01  # 10nm tolerance for circle-approximated enclosure
  padc_c_l1 = cu_pillarpad.enclosed(topmetal2, padc_c_value.um - padc_c_tol, projection).polygons
  padc_c_l2 = dfpad_pillar.and(passiv_pillar).not(topmetal2)
  padc_c = padc_c_l1.join(padc_c_l2)
  padc_c.output('Padc.c', "6.9.2. Padc.c : Min. TopMetal2 (within dfpad) enclosure of CuPillarPad is #{padc_c_value} um")
  padc_c_l1.forget
  padc_c_l2.forget
  padc_c.forget

  # Rule Padc.d: Min. CuPillarPad space to EdgeSeal is 30 um
  logger.info('Executing rule Padc.d')
  padc_d_value = drc_rules['Padc_d'].to_f
  padc_d = cu_pillarpad.separation(edgeseal, padc_d_value.um, euclidian)
  padc_d.output('Padc.d', "6.9.2. Padc.d : Min. CuPillarPad space to EdgeSeal is #{padc_d_value} um")
  padc_d.forget

  # Rule Padc.e: Min. CuPillarPad pitch is 75 um (default, see Table 6.1 for other options: 80, 95 um)
  # Note: DRCLayer#pitch not available in KLayout 0.30. Convert pitch to spacing:
  # pitch = edge_spacing + pad_size, so min_spacing = min_pitch - min_pad_size.
  # For pads larger than Padc_a, this is conservative (tighter than needed).
  logger.info('Executing rule Padc.e')
  padc_e_value = drc_rules['Padc_e'].to_f
  padc_e_tol = 0.01  # 10nm tolerance for circle-approximated spacing (see Padc.b)
  padc_e_min_space = (padc_e_value - padc_a_value).um - padc_e_tol
  padc_e = cu_pillarpad.space(padc_e_min_space, euclidian)
  padc_e.output('Padc.e', "6.9.2. Padc.e : Min. CuPillarPad pitch is #{padc_e_value} um")
  padc_e.forget

  # Rule Padc.f: Allowed passivation opening shape is Circle only
  logger.info('Executing rule Padc.f')
  padc_f_l1 = get_circle(cu_pillarpad)
  padc_f = cu_pillarpad.not(padc_f_l1)
  padc_f.output('Padc.f', '6.9.2. Padc.f: Allowed passivation opening shape is Circle only')
  padc_f_l1.forget
  padc_f.forget

end
