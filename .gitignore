# GDS files
*.gds
*.gds.gz
*.oas

# KLayout temporary files
*.lym~
*.lyp~
*.lyt~

# Python cache
__pycache__/
.pytest_cache/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Virtual environments
venv/
env/
ENV/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Log files
*.log

# Temporary files
*.tmp
*.temp
.DS_Store

# Reference example layouts are tracked despite the global *.gds ignore
!libs.ref/**/*.gds

# DRC unit-test layouts are tracked despite the global *.gds ignore
!libs.tech/klayout/tech/drc/testing/testcases/**/*.gds

# LVS unit-test layouts are tracked despite the global *.gds ignore
!libs.tech/klayout/tech/lvs/testing/testcases/**/*.gds

# DRC / LVS regression run artifacts
libs.tech/klayout/tech/drc/testing/regression_run/
libs.tech/klayout/tech/lvs/testing/regression_run/

# The commit stamp of a tree installed without .git, which the seal ring's
# version label reads (pdk_version.py); never tracked here.
/.shipped-ref
